FILEDIA 0
OSMODE 0
CMDECHO 0
(command "_.LINE" "0,0" "40,0" "")
(command "_.DIMLINEAR" "0,0" "40,0" "20,10")
(setq d (entlast))
(command "_.LINE" "10,-5" "10,20" "")
(setq l1 (entlast))
(command "_.LINE" "30,-5" "30,20" "")
(command "_.ZOOM" "_E")
(command "_.DIMBREAK" (list d '(20 10 0)) (list l1 '(10 -3 0)) (list (entlast) '(30 -3 0)) "")
(command "_.LINE" "100,0" "140,0" "")
(command "_.DIMLINEAR" "100,0" "140,0" "120,10")
(command "_.DIMBREAK" (entlast) "_M" "105,10" "110,10")
(command "_.LINE" "200,-5" "200,30" "")
(setq l2 (entlast))
(command "_.MLEADER" "190,0" "210,20" "chosen")
(command "_.ZOOM" "_E")
(command "_.DIMBREAK" (list (entlast) '(195 5 0)) (list l2 '(200 -3 0)) "")
_.SAVEAS _2018 "dimbreaks-r2018.dwg"
_.SAVEAS _2013 "dimbreaks-r2013.dwg"
_.SAVEAS _2010 "dimbreaks-r2010.dwg"
_.SAVEAS _2007 "dimbreaks-r2007.dwg"
_.SAVEAS _2004 "dimbreaks-r2004.dwg"
_.SAVEAS _2000 "dimbreaks-r2000.dwg"
_.SAVEAS _R14 "dimbreaks-r14.dwg"
_.QUIT _Y
