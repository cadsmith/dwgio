(defun property (value flags) (append value (list (cons 176 flags))))
(defun style (name kind properties) (append (list (cons 0 "VISUALSTYLE") (cons 100 "AcDbVisualStyle")
  (cons 2 name) (cons 70 kind) (cons 177 3) (cons 291 0) (cons 70 58)) (apply 'append properties)))
(setq styles (cdr (assoc -1 (dictsearch (namedobjdict) "ACAD_VISUALSTYLE"))))
