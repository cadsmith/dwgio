(defun spliced (changes groups / at out)
  (setq at -1)
  (foreach group groups
    (setq at (1+ at))
    (setq out (append out (if (assoc at changes) (cdr (assoc at changes)) (list group)))))
  out)
(setq detail (entget (cdr (assoc 350 (dictsearch (namedobjdict) "ACAD_DETAILVIEWSTYLE")))))
