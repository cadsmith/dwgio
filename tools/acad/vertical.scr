FILEDIA 0
OSMODE 0
CMDECHO 0
(entmake '((0 . "BLOCK") (2 . "Bubble") (70 . 0) (10 0.0 0.0 0.0)))
(entmake '((0 . "CIRCLE") (10 0.0 0.0 0.0) (40 . 5.0)))
(entmake '((0 . "ENDBLK")))
(setq styles (cdr (assoc -1 (dictsearch (namedobjdict) "ACAD_MLEADERSTYLE"))))
(setq standard (entget (cdr (assoc -1 (dictsearch styles "Standard")))))
(defun restyle (pairs / out)
  (setq out (vl-remove-if '(lambda (g) (member (car g) '(-1 5 330 102 360))) standard))
  (foreach p pairs (setq out (subst p (assoc (car p) out) out)))
  out)
(defun upright (name pairs)
  (dictadd styles name (entmakex (restyle (append (list (cons 3 name) (cons 271 1) (cons 90 2) (cons 273 10)
    (cons 272 9) (cons 42 1.25) (cons 43 6.0) (cons 45 3.0) (cons 142 2.0)) pairs)))))
(upright "Centered" (list (cons 176 0) (cons 297 0)))
(upright "Left" (list (cons 176 0) (cons 297 1) (cons 292 1)))
(upright "Right" (list (cons 176 2) (cons 297 1) (cons 273 9) (cons 272 10)))
(upright "Block" (list (cons 170 1) (cons 343 (cdr (assoc 330 (entget (tblobjname "BLOCK" "Bubble"))))) (cons 177 1)))
(setq x 0)
(foreach s '("Centered" "Left" "Right")
  (setvar "CMLEADERSTYLE" s)
  (command "_.MLEADER" (list x 0) (list (+ x 10) 10) "up")
  (command "_.MLEADER" (list x 100) (list (+ x 10) 90) "down\\Pbelow")
  (setq x (+ x 100)))
(setvar "CMLEADERSTYLE" "Centered")
(command "_.MLEADER" "300,100" "310,90" "both ways")
(command "_.MLEADEREDIT" (entlast) "290,60" "")
(setvar "CMLEADERSTYLE" "Right")
(command "_.MLEADER" "400,0" "410,10" "turned")
(command "_.ROTATE" (entlast) "" "400,0" "150")
(setvar "CMLEADERSTYLE" "Left")
(command "_.MLEADER" "400,100" "410,90" "turned down")
(command "_.ROTATE" (entlast) "" "400,100" "-50")
(setvar "CMLEADERSTYLE" "Block")
(command "_.MLEADER" "500,0" "510,10" "6")
_.SAVEAS _2018 "vertical-r2018.dwg"
_.SAVEAS _2007 "vertical-r2007.dwg"
_.QUIT _Y
