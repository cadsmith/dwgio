  (cons 2 "none_device") (cons 4 "") (cons 6 "") (cons 40 7.5) (cons 41 20.0) (cons 42 7.5) (cons 43 20.0)
  (cons 44 297.0) (cons 45 210.0) (cons 46 0.0) (cons 47 0.0) (cons 48 0.0) (cons 49 0.0) (cons 140 0.0)
  (cons 141 0.0) (cons 142 1.0) (cons 143 1.0) (cons 70 688) (cons 72 1) (cons 73 0) (cons 74 5) (cons 7 "")
  (cons 75 16) (cons 147 1.0) (cons 76 0) (cons 77 2) (cons 78 300) (cons 148 0.0) (cons 149 0.0))))
