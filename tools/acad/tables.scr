FILEDIA 0
OSMODE 0
CMDECHO 0
(command "_.-LINETYPE" "_L" "DASHED,CENTER,HIDDEN,GAS_LINE,FENCELINE1" "acadiso.lin" "")
(command "_.-LAYER" "_N" "Walls,Doors,Hidden" "_C" "1" "Walls" "_C" "30" "Doors" "_L" "HIDDEN" "Doors" "_L" "DASHED" "Hidden" "_LW" "0.5" "Walls" "_F" "Hidden" "_LO" "Doors" "_OFF" "Doors" "_P" "_N" "Doors" "")
(command "_.-STYLE" "Notes" "arial.ttf" "0" "0.8" "15" "_N" "_N")
(command "_.-STYLE" "Mono" "txt.shx" "2.5" "1" "0" "_N" "_N" "_N")
(command "_.ZOOM" "_W" "0,0" "100,50")
(command "_.-VIEW" "_S" "Plan")
(command "_.UCS" "_O" "10,20,0")
(command "_.UCS" "_S" "Shifted")
(command "_.UCS" "_W")
(command "_.-VPORTS" "2" "_V")
(command "_.-VPORTS" "_S" "Pair")
(regapp "DWGIO")
(setvar "DIMSCALE" 2)
(setvar "DIMTXT" 3.5)
(setvar "DIMBLK" "_DOT")
(command "_.-DIMSTYLE" "_S" "Metric")
(command "_.LINE" "0,0" "1,1" "")
(command "_.CIRCLE" "0.5,0.5" "0.25")
(command "_.-BLOCK" "Chair" "0,0" "_ALL" "")
(command "_.-INSERT" "Chair" "5,5" "1" "1" "0")
(command "_.-INSERT" "Chair" "15,5" "1" "1" "0")
(command "_.-INSERT" "Chair" "25,5" "1" "1" "0")
_.SAVEAS _2018 "tables-r2018.dwg"
_.SAVEAS _2013 "tables-r2013.dwg"
_.SAVEAS _2010 "tables-r2010.dwg"
_.SAVEAS _2007 "tables-r2007.dwg"
_.SAVEAS _2004 "tables-r2004.dwg"
_.SAVEAS _2000 "tables-r2000.dwg"
_.SAVEAS _R14 "tables-r14.dwg"
_.DXFOUT "tables-r2000.dxf" _V _2000 16
_.QUIT _Y
