(setq i 0)
(repeat 15000 (entmake (list (cons 0 "TEXT") (cons 10 (list (* 4.0 (rem i 100)) (+ 3000.0 (* 2.0 (/ i 100))) 0.0)) (cons 40 0.4) (cons 1 (strcat "T" (itoa i))))) (setq i (1+ i)))
(setq i 0)
