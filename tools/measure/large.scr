(entmake (list (cons 0 "BLOCK") (cons 2 "PART") (cons 70 0) (cons 10 (list 0.0 0.0 0.0))))
(entmake (list (cons 0 "CIRCLE") (cons 10 (list 0.0 0.0 0.0)) (cons 40 0.4)))
(entmake (list (cons 0 "LINE") (cons 10 (list -0.4 0.0 0.0)) (cons 11 (list 0.4 0.0 0.0))))
(entmake (list (cons 0 "ENDBLK")))
